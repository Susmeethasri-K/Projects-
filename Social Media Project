CREATE TRIGGER trg_accounts_after_insert
AFTER INSERT ON accounts
FOR EACH ROW
BEGIN
    INSERT INTO accounts_audit (account_id, action_performed, new_followers, changed_by)
    VALUES (NEW.account_id, 'ACCOUNT_CREATED', NEW.followers_count, CURRENT_USER());
END$$

CREATE TRIGGER trg_accounts_after_update
AFTER UPDATE ON accounts
FOR EACH ROW
BEGIN
    IF OLD.followers_count <> NEW.followers_count THEN
        INSERT INTO accounts_audit
            (account_id, action_performed, old_followers, new_followers, changed_by)
        VALUES (NEW.account_id, 'FOLLOWERS_UPDATED', OLD.followers_count,
                NEW.followers_count, CURRENT_USER());
    END IF;
END$$

CREATE TRIGGER trg_accounts_after_delete
AFTER DELETE ON accounts
FOR EACH ROW
BEGIN
    INSERT INTO accounts_audit (account_id, action_performed, old_followers, changed_by)
    VALUES (OLD.account_id, 'ACCOUNT_DELETED', OLD.followers_count, CURRENT_USER());
END$$

DELIMITER ;

UPDATE accounts SET followers_count = followers_count + 1000 WHERE account_id = 105;
SELECT * FROM accounts_audit ORDER BY audit_id;

SELECT COUNT(*)              AS total_accounts,
       SUM(followers_count)  AS total_followers,
       ROUND(AVG(followers_count),0) AS avg_followers,
       MAX(followers_count)  AS max_followers,
       MIN(followers_count)  AS min_followers
FROM accounts;

SELECT p.platform_name, SUM(a.followers_count) AS total_followers
FROM platforms p
JOIN accounts a ON a.platform_id = p.platform_id
GROUP BY p.platform_name
HAVING SUM(a.followers_count) > 35000;

SELECT p.platform_name
FROM platforms p
LEFT JOIN accounts a ON a.platform_id = p.platform_id
WHERE a.account_id IS NULL;

SELECT a1.account_name AS account, a2.account_name AS manager
FROM accounts a1
LEFT JOIN accounts a2 ON a1.managed_by = a2.account_id;

SELECT account_name, followers_count
FROM accounts
WHERE followers_count > (SELECT AVG(followers_count) FROM accounts);

SELECT account_name FROM accounts a
WHERE NOT EXISTS (SELECT 1 FROM posts p WHERE p.account_id = a.account_id);

SELECT c.comment_text, po.post_content
FROM comments c
JOIN posts po     ON po.post_id = c.post_id
JOIN accounts a   ON a.account_id = po.account_id
JOIN platforms pl ON pl.platform_id = a.platform_id
WHERE pl.platform_name = 'YouTube';

WITH high_followers AS (
    SELECT account_id, account_name, followers_count
    FROM accounts
    WHERE followers_count > 30000
),
best_post AS (
    SELECT account_id, MAX(likes_count) AS top_likes
    FROM posts
    GROUP BY account_id
)
SELECT h.account_name, h.followers_count, b.top_likes
FROM high_followers h
JOIN best_post b ON b.account_id = h.account_id
ORDER BY b.top_likes DESC;

SELECT p.platform_name, a.account_name, a.followers_count,
       RANK()       OVER (PARTITION BY p.platform_name ORDER BY a.followers_count DESC) AS rnk,
       DENSE_RANK() OVER (ORDER BY a.followers_count DESC)                              AS overall_rank
FROM accounts a
JOIN platforms p ON p.platform_id = a.platform_id;

SELECT * FROM (
    SELECT a.account_name, po.post_content, po.likes_count,
           ROW_NUMBER() OVER (PARTITION BY a.account_id ORDER BY po.likes_count DESC) AS rn
    FROM posts po
    JOIN accounts a ON a.account_id = po.account_id
) t
WHERE rn = 1;

WITH monthly AS (
    SELECT DATE_FORMAT(post_date,'%Y-%m') AS ym, SUM(likes_count) AS likes
    FROM posts
    GROUP BY DATE_FORMAT(post_date,'%Y-%m')
)
SELECT ym, likes,
       LAG(likes) OVER (ORDER BY ym) AS prev_month_likes,
       ROUND((likes - LAG(likes) OVER (ORDER BY ym)) / LAG(likes) OVER (ORDER BY ym) * 100, 1) AS growth_pct
FROM monthly;

SELECT account_name, followers_count,
       SUM(followers_count) OVER (ORDER BY followers_count DESC) AS running_total,
       ROUND(followers_count * 100 / SUM(followers_count) OVER (), 2) AS pct_of_total
FROM accounts;

SELECT account_id FROM accounts WHERE followers_count > 30000
INTERSECT
SELECT account_id FROM posts WHERE likes_count > 1500;

SELECT account_id FROM accounts
EXCEPT
SELECT account_id FROM posts;

SELECT post_id, user_name, COUNT(*) FROM likes GROUP BY post_id, user_name HAVING COUNT(*) > 1;

SELECT po.post_id, a.account_name, po.post_date, a.created_date
FROM posts po JOIN accounts a ON a.account_id = po.account_id
WHERE po.post_date < a.created_date;

SELECT po.post_id, po.likes_count AS stored_count, COUNT(l.like_id) AS detailed_rows
FROM posts po LEFT JOIN likes l ON l.post_id = po.post_id
GROUP BY po.post_id, po.likes_count;

