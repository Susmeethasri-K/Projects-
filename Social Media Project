DROP DATABASE IF EXISTS SocialMedia;
CREATE DATABASE SocialMedia CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE SocialMedia;

CREATE TABLE platforms (
    platform_id    INT PRIMARY KEY,
    platform_name  VARCHAR(100) NOT NULL UNIQUE
);

CREATE TABLE accounts (
    account_id         INT PRIMARY KEY,
    account_name       VARCHAR(100) NOT NULL,
    platform_id        INT NOT NULL,
    followers_count    INT NOT NULL DEFAULT 0 CHECK (followers_count >= 0),
    created_date       DATE NOT NULL,
    managed_by         INT NULL,
    is_active          TINYINT(1) NOT NULL DEFAULT 1,
    CONSTRAINT fk_acc_platform FOREIGN KEY (platform_id) REFERENCES platforms(platform_id),
    CONSTRAINT fk_acc_manager  FOREIGN KEY (managed_by)  REFERENCES accounts(account_id)
);

CREATE TABLE posts (
    post_id        INT PRIMARY KEY,
    account_id     INT NOT NULL,
    post_content   VARCHAR(200) NOT NULL,
    likes_count    INT NOT NULL DEFAULT 0 CHECK (likes_count >= 0),
    post_date      DATE NOT NULL,
    CONSTRAINT fk_post_account FOREIGN KEY (account_id) REFERENCES accounts(account_id)
);

CREATE TABLE comments (
    comment_id     INT PRIMARY KEY,
    post_id        INT NOT NULL,
    comment_text   VARCHAR(200) NOT NULL,
    CONSTRAINT fk_comment_post FOREIGN KEY (post_id) REFERENCES posts(post_id)
        ON DELETE CASCADE
);

CREATE TABLE likes (
    like_id        INT PRIMARY KEY,
    post_id        INT NOT NULL,
    user_name      VARCHAR(100) NOT NULL,
    UNIQUE KEY uq_like_once (post_id, user_name),
    CONSTRAINT fk_like_post FOREIGN KEY (post_id) REFERENCES posts(post_id)
        ON DELETE CASCADE
);

CREATE TABLE accounts_audit (
    audit_id         INT AUTO_INCREMENT PRIMARY KEY,
    account_id       INT NOT NULL,
    action_performed VARCHAR(100) NOT NULL,
    old_followers    INT NULL,
    new_followers    INT NULL,
    changed_by       VARCHAR(100) NOT NULL,
    changed_at       TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

