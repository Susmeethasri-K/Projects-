CREATE OR REPLACE VIEW vw_account_summary AS
SELECT  a.account_id,
        a.account_name,
        p.platform_name,
        a.followers_count,
        COUNT(DISTINCT po.post_id)        AS total_posts,
        COALESCE(SUM(po.likes_count), 0)  AS total_likes,
        ROUND(COALESCE(AVG(po.likes_count), 0), 2) AS avg_likes_per_post
FROM accounts a
JOIN platforms p      ON p.platform_id = a.platform_id
LEFT JOIN posts po    ON po.account_id = a.account_id
GROUP BY a.account_id, a.account_name, p.platform_name, a.followers_count;

CREATE OR REPLACE VIEW vw_popular_accounts AS
SELECT account_id, account_name, followers_count
FROM accounts
WHERE followers_count > 30000;

SELECT * FROM vw_account_summary ORDER BY total_likes DESC;

DELIMITER $$

CREATE FUNCTION fn_engagement_rate(p_account_id INT)
RETURNS DECIMAL(6,2)
READS SQL DATA
BEGIN
    DECLARE v_rate DECIMAL(6,2);
    SELECT ROUND(AVG(po.likes_count) / NULLIF(a.followers_count, 0) * 100, 2)
      INTO v_rate
      FROM accounts a
      JOIN posts po ON po.account_id = a.account_id
     WHERE a.account_id = p_account_id
     GROUP BY a.followers_count;
    RETURN COALESCE(v_rate, 0);
END$$

CREATE PROCEDURE sp_platform_report(IN p_start DATE, IN p_end DATE)
BEGIN
    SELECT  pl.platform_name,
            COUNT(DISTINCT a.account_id) AS accounts,
            COUNT(po.post_id)            AS posts,
            COALESCE(SUM(po.likes_count),0) AS total_likes
    FROM platforms pl
    LEFT JOIN accounts a  ON a.platform_id = pl.platform_id
    LEFT JOIN posts po    ON po.account_id = a.account_id
                         AND po.post_date BETWEEN p_start AND p_end
    GROUP BY pl.platform_name
    ORDER BY total_likes DESC;
END$$

CREATE PROCEDURE sp_add_account(
    IN p_id INT, IN p_name VARCHAR(100), IN p_platform INT,
    IN p_followers INT, IN p_created DATE)
BEGIN
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SELECT 'FAILED: account not created (duplicate name/id or invalid platform)' AS result;
    END;

    START TRANSACTION;
        INSERT INTO accounts (account_id, account_name, platform_id, followers_count, created_date)
        VALUES (p_id, p_name, p_platform, p_followers, p_created);
    COMMIT;
    SELECT 'SUCCESS: account created' AS result;
END$$

